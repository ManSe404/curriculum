---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, category, summary, stack, impact, metrics, org, period, link } =
  project.data;

// Neighbouring projects for the prev/next footer.
const all = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const index = all.findIndex((p) => p.id === project.id);
const previous = index > 0 ? all[index - 1] : null;
const next = index < all.length - 1 ? all[index + 1] : null;
---

<Base title={`${title} — Stefan Seman`} description={summary}>
  <article>
    <header class="detail-head section">
      <div class="wrap">
        <a class="back mono" href={withBase('/projects')}>
          <span aria-hidden="true">←</span> All projects
        </a>

        <div class="detail-meta">
          <span class="chip chip-ai">{category}</span>
          {org && <span class="chip">{org}</span>}
          {period && <span class="chip">{period}</span>}
        </div>

        <h1 class="detail-title">{title}</h1>
        <p class="detail-summary">{summary}</p>

        {metrics.length > 0 && (
          <dl class="metrics">
            {metrics.map((metric) => (
              <div class="metric">
                <dt class="mono">{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <div class="detail-body wrap">
      <div class="prose">
        <Content />
      </div>

      <aside class="detail-aside">
        {impact.length > 0 && (
          <section class="card aside-block">
            <h2 class="aside-title">Impact</h2>
            <ul class="aside-list">
              {impact.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="card aside-block">
          <h2 class="aside-title">Stack</h2>
          <div class="chips">
            {stack.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        </section>

        {link && (
          <a class="btn aside-link" href={link} target="_blank" rel="noopener noreferrer">
            Visit project
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </aside>
    </div>

    <nav class="detail-nav wrap" aria-label="Project navigation">
      {previous ? (
        <a class="nav-card card card-link" href={withBase(`/projects/${previous.id}`)}>
          <span class="nav-dir mono">← Previous</span>
          <span class="nav-name">{previous.data.title}</span>
        </a>
      ) : (
        <span></span>
      )}

      {next && (
        <a class="nav-card card card-link is-next" href={withBase(`/projects/${next.id}`)}>
          <span class="nav-dir mono">Next →</span>
          <span class="nav-name">{next.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .detail-head {
    padding-bottom: clamp(1.5rem, 4vh, 2.5rem);
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--text-faint);
    transition: color 0.25s var(--ease);
  }

  .back:hover {
    color: var(--bio);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .detail-title {
    font-size: clamp(2.1rem, 5.5vw, 3.5rem);
    margin-block: 1rem 1.1rem;
    text-wrap: balance;
  }

  .detail-summary {
    color: var(--text-dim);
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    max-width: 60ch;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  .metric dt {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .metric dd {
    margin: 0.3rem 0 0;
    font-size: 1.05rem;
    color: var(--bio);
  }

  /* --- Body + sidebar ---------------------------------------------------- */

  .detail-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  .detail-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 6rem;
  }

  .aside-block {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .aside-title {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-weight: 400;
  }

  .aside-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-left: 1.1rem;
  }

  .aside-list li {
    position: relative;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .aside-list li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--bio);
    box-shadow: 0 0 7px var(--glow-bio);
  }

  .aside-link {
    justify-content: center;
  }

  /* --- Prev / next ------------------------------------------------------- */

  .detail-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
    padding-bottom: 2rem;
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nav-card.is-next {
    text-align: right;
    grid-column: 2;
  }

  .nav-dir {
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  .nav-name {
    font-weight: 500;
    font-size: 0.98rem;
  }

  @media (max-width: 900px) {
    .detail-body {
      grid-template-columns: 1fr;
    }

    .detail-aside {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .detail-nav {
      grid-template-columns: 1fr;
    }

    .nav-card.is-next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
