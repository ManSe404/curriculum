---
import { getCollection } from 'astro:content';

const entries = await getCollection('collaborations');
const collaborations = entries.map((entry) => entry.data);
---

<div class="collab-grid">
  {collaborations.map((item, index) => (
    <article class="collab card" data-reveal style={`--reveal-delay:${index * 90}ms`}>
      <div class="collab-head">
        <h3 class="collab-name">{item.name}</h3>
        <span class="chip chip-bio">{item.kind}</span>
      </div>

      <p class="collab-via mono">via {item.via}</p>
      <p class="collab-desc">{item.description}</p>

      {item.tags.length > 0 && (
        <div class="chips">
          {item.tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )}
    </article>
  ))}
</div>

<style>
  .collab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.15rem;
  }

  .collab {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .collab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .collab-name {
    font-size: clamp(1.1rem, 2vw, 1.32rem);
  }

  .collab-via {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }

  .collab-desc {
    color: var(--text-dim);
    font-size: 0.93rem;
  }
</style>
