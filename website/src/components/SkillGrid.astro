---
import skills from '../data/skills.json';
---

<div class="skill-grid">
  {skills.map((group, index) => (
    <section class="skill card" data-reveal style={`--reveal-delay:${index * 60}ms`}>
      <h3 class="skill-title">
        <span class="skill-marker" aria-hidden="true"></span>
        {group.group}
      </h3>
      <ul class="chips">
        {group.items.map((item) => (
          <li class="chip">{item}</li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.1rem;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .skill-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.98rem;
    font-weight: 600;
  }

  .skill-marker {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--bio);
    box-shadow: 0 0 9px var(--glow-bio);
    transform: rotate(45deg);
    flex-shrink: 0;
  }
</style>
