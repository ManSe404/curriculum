---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, category, summary, stack, impact, metrics, org, client } =
  project.data;

// "404 Solutions · with Provectus" — the partner only appears when there is one.
const attribution = [org, client && `with ${client}`].filter(Boolean).join(' · ');

// Show the leading stack items only; the full list lives on the detail page.
const shownStack = stack.slice(0, featured ? 8 : 5);
const overflow = stack.length - shownStack.length;
---

<a
  class={`project card card-link ${featured ? 'is-featured' : ''}`}
  href={withBase(`/projects/${project.id}`)}
  data-reveal
>
  <div class="project-top">
    <span class="chip chip-ai">{category}</span>
    {featured && metrics.length > 0 && (
      <span class="mono project-metric">{metrics[0].value}</span>
    )}
  </div>

  <h3 class="project-title">{title}</h3>
  {attribution && <p class="project-org mono">{attribution}</p>}
  <p class="project-summary">{summary}</p>

  {featured && impact.length > 0 && (
    <ul class="project-impact">
      {impact.slice(0, 3).map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}

  <div class="chips project-stack">
    {shownStack.map((tech) => (
      <span class="chip">{tech}</span>
    ))}
    {overflow > 0 && <span class="chip">+{overflow}</span>}
  </div>

  <span class="project-cta mono" aria-hidden="true">Read case study →</span>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-metric {
    font-size: 0.72rem;
    color: var(--text-faint);
    text-align: right;
  }

  .project-title {
    line-height: 1.25;
  }

  .project-org {
    font-size: 0.73rem;
    color: var(--bio);
    letter-spacing: 0.04em;
    margin-top: -0.45rem;
  }

  .is-featured .project-title {
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
  }

  .project-summary {
    color: var(--text-dim);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .project-impact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-left: 1.1rem;
  }

  .project-impact li {
    position: relative;
    font-size: 0.89rem;
    color: var(--text-dim);
  }

  .project-impact li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--bio);
    box-shadow: 0 0 7px var(--glow-bio);
  }

  .project-stack {
    margin-top: 0.15rem;
  }

  .project-cta {
    font-size: 0.76rem;
    color: var(--text-faint);
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .project:hover .project-cta {
    color: var(--bio);
    transform: translateX(3px);
  }
</style>
