---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  lede?: string;
}

const { id, eyebrow, title, lede } = Astro.props;
---

<section class="section" id={id}>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      {lede && <p>{lede}</p>}
    </header>

    <slot />
  </div>
</section>
